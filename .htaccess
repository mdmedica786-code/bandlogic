# BandLogic on Hostinger: serve the built React app from site/
# (built by .github/workflows/deploy-web.yml) and keep source folders private.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Already inside the build folder: stop rewriting
  RewriteRule ^site/ - [L]

  # Real file in the build folder (JS, CSS, images, html pages): serve it
  RewriteCond %{DOCUMENT_ROOT}/site/$1 -f
  RewriteRule ^(.*)$ site/$1 [L]

  # Folder with its own index.html in the build folder (e.g. /blog/): serve it
  RewriteCond %{DOCUMENT_ROOT}/site/$1index.html -f
  RewriteRule ^(.*/)$ site/$1index.html [L]

  # Folder without trailing slash (e.g. /blog): redirect to /blog/
  RewriteCond %{DOCUMENT_ROOT}/site/$1/index.html -f
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Everything else (including source folders): the React app
  RewriteRule ^ site/index.html [L]
</IfModule>
